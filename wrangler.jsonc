{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "indiadata-viz",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "indiadata.orosant.com",
      "custom_domain": true
    }
  ]
}
